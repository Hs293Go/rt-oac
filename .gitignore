# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# JAX / XLA persistent compilation cache
.cache/

# Results: keep summary CSV/markdown + report.{tex,md,pdf}, ignore bulky raw artifacts
results/**/*.npz
results/**/*.png
results/**/*.gif
results/**/*.rrd
results/**/*.pkl
results/**/*.eqx
!results/**/.gitkeep

# LaTeX build intermediates (results/report.tex builds in place)
results/**/*.aux
results/**/*.fdb_latexmk
results/**/*.fls
results/**/*.log
results/**/*.out

# Hydra: job logging is disabled in the example configs, but guard against an override that
# re-enables it dumping <script>.log / a per-run dir in the repo root.
*.log
outputs/
multirun/

# Report pipeline: generated run data + LaTeX build (regenerate via report/sweep.sh + latexmk).
# report/figures/ and report/tables/ ARE tracked so the report compiles from a fresh checkout.
report/data/
report/improving_beginners_oac.pdf
report/*.aux
report/*.fls
report/*.fdb_latexmk
report/*.out
report/*.synctex.gz

# Editor
.vscode/
.idea/

# Claude Code agent working directory
.claude/
multirun.yaml
